# Generated-output hashes must survive checkout on Windows and Unix.
*.ts text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.scene text eol=lf
*.md text eol=lf
*.png binary
*.psd binary

# Preserve the delivered art package byte-for-byte, including checksum files.
/arts/** -text
