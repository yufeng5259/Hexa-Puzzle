# Track only the Cocos project; all other root entries stay local.
/*
!/.gitignore
!/.gitattributes
!/assets/
!/arts/
!/build-templates/
!/native/
!/settings/
!/package.json
!/package-lock.json
!/npm-shrinkwrap.json
!/tsconfig.json

#///////////////////////////
# Cocos Creator 3D Project
#///////////////////////////
library/
temp/
local/
build/
profiles/

# Keep customized Android/common native sources; ignore generated platforms.
native/*
!native/engine/
native/engine/*
!native/engine/android/
!native/engine/common/
# Unused Instant App template; the standard Android app is kept above.
/native/engine/android/instantapp/
native/**/.gradle/
native/**/.cxx/
native/**/.externalNativeBuild/
native/**/build/
native/**/app/debug/
native/**/app/release/
native/**/captures/
native/**/local.properties
native/**/localCfg.cmake
native/**/*.jks
native/**/*.keystore
native/**/signing.properties
native/**/key.properties
native/**/ad-config.release.properties
native/**/ad-config.local.properties
.creator/
.omx/
.cache/

# WeChat DevTools preferences are private to each developer.
project.private.config.json

# Local builds, exports and temporary work (not build-templates).
/output/
/dist/
/tmp/
/evidence/
*.apk
*.aab
*.apks
*.idsig

# Local documentation, historical archives and development tools.
/docs/
/archive/
/archieve/
/tools/

# Generated test output.
/test-results/
/playwright-report/
/blob-report/
/coverage/
.nyc_output/
*.tsbuildinfo

# Python caches from asset tooling.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Machine-local environment values.
.env
.env.*

#//////////////////////////
# NPM
#//////////////////////////
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.log.*

#//////////////////////////
# OS generated files
#//////////////////////////
.DS_Store
Thumbs.db
desktop.ini
Thumbs.db:encryptable
$RECYCLE.BIN/
~$*
*.swp
*.swo
*~

#//////////////////////////
# VSCode
#//////////////////////////
.vscode/

#//////////////////////////
# WebStorm
#//////////////////////////
.idea/
.vs/
.history/

# Development tools and documents for the rebuild (docs/开发方案).
!/tools/
/tools/*
!/tools/ui-gen/
!/tools/art-import/
!/tools/framework/
!/tools/tests/
!/tools/i18n/
!/tools/smoke/
!/tools/android/
/tools/smoke/node_modules/
!/tools/tsconfig.json
!/tools/cc-env.d.ts
!/docs/
/docs/*
!/docs/repository-maintenance.md
!/docs/游戏美术素材制作与验收规范.md
!/docs/开发方案/
!/docs/策划/
!/docs/重建计划/
!/AGENTS.md

# Editable PSD sources remain local; exported art stays versioned.
*.[pP][sS][dD]

# Local art candidates, browser profiles, API wrappers and production evidence.
# Portable deliverables and their verification receipt live directly in arts/.
/arts/补充制作记录/
