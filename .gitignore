# Track only the Cocos project; all other root entries stay local.
/*
!/.gitignore
!/.gitattributes
!/assets/
!/build-templates/
!/native/
!/settings/
!/package.json
!/package-lock.json
!/npm-shrinkwrap.json
!/tsconfig.json

#///////////////////////////
# Cocos Creator 3D Project
#///////////////////////////
library/
temp/
local/
build/
profiles/

# Keep customized Android/common native sources; ignore generated platforms.
native/*
!native/engine/
native/engine/*
!native/engine/android/
!native/engine/common/
# Unused Instant App template; the standard Android app is kept above.
/native/engine/android/instantapp/
native/**/.gradle/
native/**/.cxx/
native/**/.externalNativeBuild/
native/**/build/
native/**/app/debug/
native/**/app/release/
native/**/captures/
native/**/local.properties
native/**/localCfg.cmake
native/**/*.jks
native/**/*.keystore
native/**/signing.properties
native/**/key.properties
native/**/ad-config.release.properties
native/**/ad-config.local.properties
.creator/
.omx/
.cache/

# WeChat DevTools preferences are private to each developer.
project.private.config.json

# Local builds, exports and temporary work (not build-templates).
/output/
/dist/
/tmp/
/evidence/
*.apk
*.aab
*.apks
*.idsig

# Local documentation, historical archives and development tools.
/docs/
/archive/
/archieve/
/tools/

# Generated test output.
/test-results/
/playwright-report/
/blob-report/
/coverage/
.nyc_output/
*.tsbuildinfo

# Python caches from asset tooling.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Machine-local environment values.
.env
.env.*

#//////////////////////////
# NPM
#//////////////////////////
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.log.*

#//////////////////////////
# OS generated files
#//////////////////////////
.DS_Store
Thumbs.db
desktop.ini
Thumbs.db:encryptable
$RECYCLE.BIN/
~$*
*.swp
*.swo
*~

#//////////////////////////
# VSCode
#//////////////////////////
.vscode/

#//////////////////////////
# WebStorm
#//////////////////////////
.idea/
.vs/
.history/

# Keep the new foundation reproducible without enrolling historical local tools.
!/tools/
/tools/*
!/tools/prefab-foundation/
/tools/prefab-foundation/*
!/tools/prefab-foundation/*.mjs
!/tools/prefab-foundation/raster.py
!/tools/prefab-foundation/generated-files.json
!/tools/prefab-foundation/core-actions.json
!/tools/prefab-foundation/layout-manifest.json
!/tools/prefab-foundation/tests/
/tools/prefab-foundation/tests/*
!/tools/prefab-foundation/tests/*.mjs
!/tools/prefab-foundation/tests/fixtures/
/tools/prefab-foundation/tests/fixtures/*
!/tools/prefab-foundation/tests/fixtures/authored-visuals-before.json
!/docs/
/docs/*
!/docs/prefab-foundation.md
!/docs/level-prefabs.md
!/docs/single-level-play.md
!/docs/ui-integration.md
!/docs/loading-page.md
!/docs/mainline-page.md
!/docs/mainline-sidebar.md
!/docs/repository-maintenance.md
!/docs/source-inputs.json
!/docs/策划/
!/AGENTS.md
