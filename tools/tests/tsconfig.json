{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "outDir": "../../.test-build",
    "rootDir": "../../assets/scripts",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "../../assets/scripts/game/domain/**/*.ts",
    "../../assets/scripts/game/save/**/*.ts",
    "../../assets/scripts/game/config/**/*.ts",
    "../../assets/scripts/framework/core/**/*.ts"
  ]
}
